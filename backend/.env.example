MONGO_URI=mongodb+srv://username:password@cluster.mongodb.net/visioncart
JWT_SECRET=change_this_to_long_random_string
SESSION_SECRET=change_this_to_another_random_string
ADMIN_EMAIL=your@email.com
ADMIN_PASSWORD=YourStrongPassword123
PORT=5000

SERVER_URL=https://vision-cart.onrender.com
CLIENT_URL=https://vision-cart-5702.onrender.com

UPI_ID=yourname@bank
UPI_NAME=VisionCart Store

GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret

DISCORD_CLIENT_ID=your_discord_client_id
DISCORD_CLIENT_SECRET=your_discord_client_secret

# Cloudinary (free at cloudinary.com — for direct image/video upload)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Discord webhook URL (for payment notifications)
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/your_webhook_url

# Secret shared between backend and Discord bot
DISCORD_BOT_SECRET=replace_with_random_shared_secret_32_plus_chars
